package utils;

import java.io.File;
import java.io.IOException;
import javax.imageio.ImageIO;
import org.openqa.selenium.OutputType;
import org.openqa.selenium.TakesScreenshot;
import org.openqa.selenium.WebDriver;
import ru.yandex.qatools.ashot.AShot;
import ru.yandex.qatools.ashot.Screenshot;

public class ScreenshotUtil {

    // Capture visible viewport screenshot
    public static void captureScreenshot(WebDriver driver, String filePath) {
        try {
            File file = new File(filePath);
            file.getParentFile().mkdirs(); // ensures parent folders exist
            File src = ((TakesScreenshot) driver).getScreenshotAs(OutputType.FILE);
            org.apache.commons.io.FileUtils.copyFile(src, file);
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

    // Capture full-page screenshot using AShot
    public static void captureFullPageScreenshot(WebDriver driver, String filePath) {
        Screenshot screenshot = new AShot().takeScreenshot(driver);
        try {
            File file = new File(filePath);
            file.getParentFile().mkdirs(); // ensures parent folders exist
            ImageIO.write(screenshot.getImage(), "PNG", file);
        } catch (IOException e) {
            e.printStackTrace();
        }
    }
}
